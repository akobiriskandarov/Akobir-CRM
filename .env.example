# --- Majburiy ---
# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=123456789:AA...
# https://console.anthropic.com dan olingan Claude API kaliti
ANTHROPIC_API_KEY=sk-ant-...

# --- Kirish huquqi ---
# Botdan foydalana oladigan jamoa a'zolarining Telegram ID lari (vergul bilan).
# ID ni bilish uchun botga /start yozing — ruxsat bo'lmasa bot ID ni ko'rsatadi.
ALLOWED_USER_IDS=
# /statistika ko'ra oladigan administratorlar (avtomatik ruxsat ham oladi)
ADMIN_USER_IDS=

# --- Ixtiyoriy ---
BOT_NAME=Bovari Agency
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (Marketolog va Analitik har doim high)
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000
# Har bir agent eslab qoladigan oxirgi savol-javoblar soni
HISTORY_TURNS=12
# Marketolog va Analitik uchun internetdan qidiruv (true/false)
WEB_SEARCH=true
DB_PATH=data/bovari.db
